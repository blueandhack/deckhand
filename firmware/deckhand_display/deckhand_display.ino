// Sprite id for a link's icon, or -1 when it has none or the name is unknown to this
// firmware - which is the fallback path: the caller then draws the TEXT tag instead, so
// a name this build has never heard of degrades to what the device did before icons.
int emojiIdForLink(int link) {
  if (link < 0 || link >= MAX_LINKS || !hostLinks[link].used) return -1;
  if (!hostLinks[link].emoji[0]) return -1;
  return macEmojiIndex(hostLinks[link].emoji);
}
