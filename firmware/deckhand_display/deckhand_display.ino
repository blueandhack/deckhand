const int MIC_CUE_DUTY = 18;



// ---------- MICREC: record real audio and ship it to the Mac ----------
// Levels only ever told us "something is louder than the floor". To judge
// whether this mic is usable for speech we have to LISTEN, so this captures a
// couple of seconds and dumps it as base64 for the host to turn into a WAV.
//
// Sampled by DMA (adc_continuous), NOT the busy-loop the diagnostics use. A
// 2-second tight loop would starve this core's idle task and trip the task
// watchdog, and the obvious workaround - yielding every 200ms - punches 1ms
// holes in the audio at 5Hz, which buzzes and wrecks the very judgement we're
// making. adc_continuous_read() blocks on a semaphore instead, so the CPU is
// free while the hardware fills buffers gap-free.
//
// Sampled at 32kHz and averaged 4:1 down to 8kHz, because on this chip the DMA
// driver's MINIMUM rate is 20kHz (SOC_ADC_SAMPLE_FREQ_THRES_LOW) - 8kHz can't
// be asked for directly. The 4:1 average doubles as an anti-alias filter and
// buys ~6dB of noise reduction, which this signal can use.
// 16kHz, because that is what Whisper is trained on. At 8kHz everything above
// 4kHz is gone, and that band is where consonants separate (s/f/th) - it costs
// real transcription accuracy. The DMA already runs at 32kHz, so this is a 2:1
// decimation instead of 4:1 (giving up ~3dB of the averaging's noise benefit).
#define MIC_REC_RATE_OUT 16000
#define MIC_REC_OVERSAMPLE 2

// Stored as 8-bit G.711 mu-law rather than 16-bit linear. 16kHz x 16-bit x 5s is
// 160KB and the heap only had room for 64KB (BLE takes most of it), which would
// have capped a take at 2 seconds - too short to reliably catch a sentence, as
// every timing failure in this feature's history demonstrates. mu-law is
// logarithmic, so it keeps fine resolution near zero where this quiet signal
// actually lives, and 5s costs the same 80KB that 8kHz/16-bit did.
#define MIC_REC_CODEC "ulaw"

// 5s, not 2. A 2s window has to be HIT: you wait out the cue, then talk inside a
// two-second slot, and a capture that misses it is indistinguishable from a mic
// that heard nothing - which is exactly the trap MICTEST already hit before it
// was widened to 10s. Costs 80KB of heap at 16-bit/8kHz, so the allocation falls
// back to a shorter take rather than failing outright.
#define MIC_REC_SECONDS 5
#define MIC_REC_MIN_SECONDS 2

// Base64, 3 bytes -> 4 chars. Written out rather than pulled in from mbedtls so
// the wire format stays obvious when reading the host log by hand.
static const char B64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

// One screenshot row (480 bytes) as base64 on a single "SHOT d" line. Kept
// separate from micDumpBase64 because that one drives a progress meter and
// chunks to 144 bytes; here a row IS the natural unit, so the host can rebuild
// the image without tracking offsets.
void shotDumpBase64(const uint8_t* data, size_t n) {
  // SIZED FROM BOARD_W, never a literal. This was `char line[660]` - "480 bytes
  // -> 640 chars + NUL", correct for a 240px row and a STACK SMASH on a 320px
  // one: 640 bytes encode to 856 chars, so it overran by 197 bytes and the
  // SCREENSHOT never returned. It presented as the capture silently never
  // finishing - "SHOT begin" logged, no rows, no "SHOT end", and not even
  // finishShot()'s own incomplete warning, because the function it would have
  // been called from had already destroyed its own frame.
  char line[(BOARD_W * 2 + 2) / 3 * 4 + 1];
  int o = 0;
  for (size_t i = 0; i < n; i += 3) {
    uint32_t v = (uint32_t) data[i] << 16;
    if (i + 1 < n) v |= (uint32_t) data[i + 1] << 8;
    if (i + 2 < n) v |= data[i + 2];
    line[o++] = B64[(v >> 18) & 63];
    line[o++] = B64[(v >> 12) & 63];
    line[o++] = (i + 1 < n) ? B64[(v >> 6) & 63] : '=';
    line[o++] = (i + 2 < n) ? B64[v & 63] : '=';
  }
  line[o] = '\0';
  Serial.printf("SHOT d %s\n", line);
}


