// ---------- Easter egg: the octopus ----------
// Tap the footer 5 times within 4 seconds. A Claude-orange octopus swims
// around until the next tap (or 30s). Frames render into a sprite and push
// whole, keeping the animation flicker-free; if the sprite allocation fails
// next to the BLE stack's heap use, it degrades to slower direct drawing.
// One name, two surfaces. PanelSprite (panel_sprite.h) implements exactly the
// slice of TFT_eSprite this sketch uses, with the same createSprite() non-null
// contract startOctopus() tests - and drawCrab() is templated, so it binds to
// whichever fillRect() belongs to the surface it was handed. That template is
// load-bearing rather than tidy: TFT_eSPI declares very few methods virtual, so
// through a base reference pushImage() would bind to the SCREEN version and
// silently bypass the sprite (which is why the crab was invisible at first).
#if BOARD_USES_TFT_ESPI
TFT_eSprite octoSprite = TFT_eSprite(&tft);
#else
PanelSprite octoSprite = PanelSprite(&tft);
#endif
bool octoActive = false;
bool octoSpriteOk = false;
unsigned long octoStartMillis = 0;
unsigned long octoLastFrameMillis = 0;
// OCTO_W/H/X/Y moved to board_e32r28t.h (via board.h) - see the note there
// on why ClawdCrab.h had to move ahead of board.h in the include order.

// Clawd, walking. 20 frames of real sprite art (ClawdCrab.h, generated by
// crab2c.py; the source frames aren't in the repo). Palette indices + an
// RGB565 palette - only ~66 distinct colours survive RGB565, so indexing is
// LOSSLESS and about half the size of raw RGB565 (~36KB of flash).
// The alpha was composited against COLOR_BG at build time, so there is no
// per-pixel blending here: it's a palette lookup and a scale-up blit.
const int CRAB_SCALE = 3;                       // 51x36 art -> 153x108 on screen
const int CRAB_DRAW_W = CRAB_W * CRAB_SCALE;
const int CRAB_DRAW_H = CRAB_H * CRAB_SCALE;
int  crabFrame = 0;
int  crabX = -CRAB_DRAW_W;                      // walks in from the left edge

// Blit one frame, scaled, at (ox,oy). Builds a scaled row once and repeats it
// CRAB_SCALE times, so the palette lookup happens per SOURCE pixel rather than
// per screen pixel - 3x less work than a naive nearest-neighbour loop.
// Draws one frame, scaled, at (ox,oy) by decoding the RLE straight into
// fillRect calls - the stored format IS the draw format, so nothing is
// decompressed into RAM and it's ~527 calls per frame instead of 1836 pixels.
//
// fillRect (not pushImage) on purpose. pushImage takes a raw buffer, so its
// byte order depends on the target's `swapBytes` flag - and a sprite stores its
// pixels byte-SWAPPED internally, which is what made the colours come out
// wrong. fillRect takes an ordinary 0xF800-style colour and handles the
// internal representation itself, so this is correct on a sprite and on the
// screen with no flag juggling.
//
// Still templated on the target: TFT_eSPI declares very few methods virtual, so
// through a TFT_eSPI& reference the call could bind to the screen version and
// silently bypass the sprite (which is why the crab was invisible at first).
template <typename G>
void drawCrab(G& g, int ox, int oy, int frame) {
  int f = frame % CRAB_FRAMES;
  int i = pgm_read_word(&CRAB_OFF[f]), end = pgm_read_word(&CRAB_OFF[f + 1]);
  int x = 0, y = 0;
  while (i < end) {
    uint8_t idx = pgm_read_byte(&CRAB_RLE[i++]);
    uint8_t len = pgm_read_byte(&CRAB_RLE[i++]);
    // palette entry 0 is COLOR_BG; the target was just cleared, so skip it
    if (idx) g.fillRect(ox + x * CRAB_SCALE, oy + y * CRAB_SCALE,
                        len * CRAB_SCALE, CRAB_SCALE, pgm_read_word(&CRAB_PAL[idx]));
    x += len;
    if (x >= CRAB_W) { x = 0; y++; }
  }
}

void renderOctoFrame() {
  lastActivityMillis = millis(); // the show counts as activity: no dozing off mid-walk
  crabFrame++;
  crabX += 3;                                   // strolls left -> right
  if (crabX > tft.width()) crabX = -CRAB_DRAW_W;  // ...and comes round again
  if (octoSpriteOk) {
    octoSprite.fillSprite(COLOR_BG);
    // Draw at the walk offset INSIDE the sprite, so the whole strip repaints
    // atomically and the crab never tears as it moves.
    drawCrab(octoSprite, crabX - OCTO_X, 0, crabFrame);
    octoSprite.pushSprite(OCTO_X, OCTO_Y);
  } else {
    tft.fillRect(OCTO_X, OCTO_Y, OCTO_W, OCTO_H, COLOR_BG);
    drawCrab(tft, crabX, OCTO_Y, crabFrame);
  }
#if !BOARD_USES_TFT_ESPI
  // Called on its own 25-40fps cadence from loop(), independent of the
  // once-per-second tab renders - flushing here bounds each frame's cost to
  // just this blit rather than whatever else that tick also touched.
  tft.flush();
#endif
}

void startOctopus() {
  octoActive = true;
  octoStartMillis = millis();
  octoLastFrameMillis = 0;
  octoSpriteOk = octoSprite.createSprite(OCTO_W, OCTO_H) != nullptr;
  Serial.printf("OCTO: surfacing (sprite=%d)\n", (int) octoSpriteOk);
  tft.fillScreen(COLOR_BG);
  setUIFont(2);
  tft.setTextColor(COLOR_ACCENT, COLOR_BG);
  tft.setTextDatum(MC_DATUM);
  tft.drawString("you found Clawd", tft.width() / 2, 60);
  setUIFont(1);
  tft.setTextColor(COLOR_LABEL, COLOR_BG);
  tft.drawString("tap anywhere to send it home", tft.width() / 2, tft.height() - 12);
  crabFrame = 0;
  crabX = -CRAB_DRAW_W;   // always starts its walk off-screen
  tft.setTextDatum(TL_DATUM);
}

void stopOctopus() {
  octoActive = false;
  octoSprite.deleteSprite(); // hand the ~54KB back before normal rendering resumes
  tft.fillScreen(COLOR_BG);
  drawTabBar();
  drawFooterChrome();
  if (currentTab == TAB_USAGE) {
    resetUsageCaches();
    drawUsageStatic();
    renderUsageTab();
  } else if (currentTab == TAB_SESSIONS) {
    drawSessionsAll();
  } else {
    drawSettingsTab();
  }
  renderFooter();
}

// ---------- Tab switching ----------
// Repaint the current tab from scratch. Needed after the floating button MOVES:
// the change-only redraw discipline has no record of what the button was covering,
// so the only correct way to reveal it is a full repaint of the tab. Moving is
// rare, so the cost is irrelevant.
void forceFullRepaint() {
  drawTabBar();
  drawFooterChrome();
  tft.fillRect(0, CONTENT_Y, tft.width(), contentBottom() - CONTENT_Y, COLOR_BG);
  if (currentTab == TAB_USAGE) {
    resetUsageCaches();
    drawUsageStatic();
    renderUsageTab();
  } else if (currentTab == TAB_SESSIONS) {
    drawSessionsAll();
  } else {
    drawSettingsStatic(); // resets its own caches
    renderSettingsTab();
  }
  renderFooter();
}

// ---------- EMOJITEST ----------
// Draws all 16 icons, or just one if named, on the content area, on BOTH backdrops a
// real icon actually has to sit on: the page background (COLOR_BG) and a card/row
// fill (COLOR_CARD). There is no other mode - an unrecognised name (macEmojiIndex
// returns -1) falls through to the same all-16 grid plain EMOJITEST draws. The alpha
// blend and the setSwapBytes handling can only be judged where they actually have to
// work, not on some third colour picked for convenience - and this is the only way
// any of the 16 reach the real glass, since the capture path (SCREENSHOT) can only
// record what is currently displayed.
void drawEmojiTestScreen(const char* only) {
  tft.fillRect(0, CONTENT_Y, tft.width(), contentBottom() - CONTENT_Y, COLOR_BG);

  int onlyId = (only && only[0]) ? macEmojiIndex(only) : -1;
  int n = (onlyId >= 0) ? 1 : MAC_EMOJI_COUNT;
  uint8_t font = (n == 1) ? T_HEAD : T_META;
  int gap = (n == 1) ? 6 : 2;

  const int secH = (contentBottom() - CONTENT_Y) / 2;
  const uint16_t backdrop[2] = { COLOR_BG, COLOR_CARD };

  int cols = (n == 1) ? 1 : 4;
  int rows = (n + cols - 1) / cols;
  int cellW = tft.width() / cols;
  int cellH = secH / rows;
  int blockH = MAC_EMOJI_SIZE + gap + uiLineH(font);

  setUIFont(font);
  tft.setTextDatum(TC_DATUM);
  for (int s = 0; s < 2; s++) {
    int sy = CONTENT_Y + s * secH;
    // COLOR_BG is already the cleared backdrop from the fillRect above; only the
    // card swatch needs its own fill.
    if (backdrop[s] != COLOR_BG) tft.fillRect(0, sy, tft.width(), secH, backdrop[s]);
    for (int i = 0; i < n; i++) {
      int id = (onlyId >= 0) ? onlyId : i;
      int col = i % cols, row = i / cols;
      int cx = col * cellW + cellW / 2;
      int cy = sy + row * cellH + (cellH - blockH) / 2;
      drawEmoji(id, cx - MAC_EMOJI_SIZE / 2, cy, backdrop[s]);
      tft.drawString(MAC_EMOJI_NAMES[id], cx, cy + MAC_EMOJI_SIZE + gap);
    }
  }
  tft.setTextDatum(TL_DATUM);
}

void switchTab(Tab newTab) {
  if (newTab == currentTab) return;
#if !BOARD_USES_TFT_ESPI
  // Timed because "switching tabs feels slow" was a real report and the flush is
  // only part of it - the render has to be measured separately or the wrong half
  // gets optimised. One line per switch, which is rare enough not to be noise.
  const uint32_t swT0 = micros();
#endif
  currentTab = newTab;
  showingDetail = false;
  drawTabBar();
  tft.fillRect(0, CONTENT_Y, tft.width(), contentBottom() - CONTENT_Y, COLOR_BG);

  if (currentTab == TAB_USAGE) {
    // With no data yet, the usage cards are empty outlines - renderUsageTab bails
    // on !everReceived - so USAGE is where the standalone screen belongs. SETTINGS
    // stays reachable and useful while waiting: it shows the link and pairing state.
    if (!everReceived) { drawWaitingScreen(); return; }
#if !BOARD_USES_TFT_ESPI
    { const uint32_t a = micros(); resetUsageCaches();
      const uint32_t b = micros(); drawUsageStatic();
      const uint32_t c = micros(); renderUsageTab();
      const uint32_t d = micros();
      Serial.printf("PERF usage: reset %lu  static %lu  render %lu us\n",
                    (unsigned long)(b-a), (unsigned long)(c-b), (unsigned long)(d-c)); }
#else
    resetUsageCaches();
    drawUsageStatic();
    renderUsageTab();
#endif
  } else if (currentTab == TAB_SESSIONS) {
    drawSessionsAll();
  } else {
    drawSettingsTab();
  }
#if !BOARD_USES_TFT_ESPI
  Serial.printf("PERF switchTab -> %d took %lu us\n", (int) currentTab,
                (unsigned long) (micros() - swT0));
#endif
}

