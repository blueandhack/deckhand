# --- macOS / editor junk ---
.DS_Store
__pycache__/
*.pyc

# --- local Claude Code settings (contains machine-specific paths) ---
.claude/

# --- host runtime ---
host/node_modules/
# DeckhandBLE.app embeds a COPY of the Homebrew `node` binary (~72MB) plus
# libnode.dylib. It is machine- and version-specific, and redistributing
# someone else's node build is not ours to do - rebuild it locally instead
# (see README / CLAUDE.md).
host/DeckhandBLE.app/

# --- build output (regenerate with mac-app/build.sh) ---
mac-app/DeckhandMenuBar.app/

# --- personal build photos: useful to me, not to anyone reading the repo ---
case/photos/

# --- third-party reference models (not ours to redistribute) ---
case/example/

# --- scratch renders ---
case/preview_*.png
!case/preview_hero.png

# --- anything that looks like a credential, belt and braces ---
*.pem
*.key
.env
deckhand-secret*

# --- arduino-cli --build-path output: 38MB of ELF and map files, regenerated by
# any compile. It landed in a commit once (during a disassembly to settle an
# 8-byte question) and cost 19.7MB of diff, so it is named here rather than
# left to the next person to notice. ---
firmware/deckhand_display/build/
