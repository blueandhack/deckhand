<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the bundled Node ("Deckhand Host") under the hardened runtime.
  Each one is here because V8 cannot run without it, and nothing else is:

  allow-jit                         V8 compiles JavaScript to machine code at run
                                    time, into MAP_JIT memory.
  allow-unsigned-executable-memory  V8 also writes and executes code pages outside
                                    MAP_JIT (its WebAssembly and regexp tiers).

  Deliberately ABSENT:
  disable-library-validation        every native addon in the bundle (noble,
                                    serialport) is re-signed with the same team as
                                    Node, so library validation can stay ON and
                                    refuses any .node file that is not ours.
  Bluetooth / audio-input           those are App Sandbox entitlements; this app is
                                    not sandboxed. Bluetooth is governed by TCC and
                                    the usage strings in the helper's Info.plist.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
