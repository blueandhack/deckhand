{
  "_comment": "Reference only. Run `node claude-hooks/install-hooks.mjs` to merge this into ~/.claude/settings.json safely (it substitutes your real home path, dedupes, and backs up first). The paths below use $HOME as a placeholder.",
  "statusLine": {
    "type": "command",
    "command": "node $HOME/.claude/deckhand-statusline.mjs",
    "refreshInterval": 15
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/deckhand-session-hook.mjs",
            "timeout": 100
          }
        ]
      }
    ]
  }
}
